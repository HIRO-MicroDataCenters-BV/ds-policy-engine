# ============================================================
# ds-policy-engine — Environment Template
# All variables prefixed DS__ (pydantic-settings env_prefix).
# ============================================================

# --- OPA ---
DS__OPA_BASE_URL=http://ds-opa:8181
DS__OPA_TIMEOUT=3.0
DS__OPA_POLICY_PATH=ds/authz/decision

# --- Server ---
DS__LOG_LEVEL=INFO
DS__DOCS_ENABLED=true

# --- Node / Environment ---
# Used when seeding default institute for rules without one.
DS__NODE_NAME=local

# --- Paths ---
DS__POLICIES_DIR=/code/policies

# --- Database ---
# SQLite (default):
DS__DATABASE_URL=sqlite+aiosqlite:////app/data/policy_engine.db
# PostgreSQL (future):
# DS__DATABASE_URL=postgresql+asyncpg://user:pass@db:5432/policy_engine

# --- CORS ---
# Comma-separated list of origins allowed to call the API.
DS__CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
