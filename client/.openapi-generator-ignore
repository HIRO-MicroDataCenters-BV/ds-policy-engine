# Files the generator should never produce or overwrite.
# Format documented at: https://openapi-generator.tech/docs/customization#ignore-file-format
#
# pyproject.toml, README.md, setup.cfg, tox.ini are NOT listed here:
# they ARE generated, but from the custom mustache templates under
# tools/client_generator/templates/ (so they end up matching the
# package + repo conventions).

.github/**
.openapi-generator-ignore
.gitlab-ci.yml
.travis.yml
.gitignore
git_push.sh
requirements.txt
setup.py
test-requirements.txt
LICENSE
generator

